---
import { apps } from "../data/portfolio";
import AppCard from "./AppCard.astro";
const featuredApps = apps.filter((app) => app.featured);
---
<section id="apps" class="reveal scroll-mt-24 border-b border-border py-16 sm:py-24">
  <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="font-display text-4xl font-semibold text-ink sm:text-5xl">Apps</h2>
    <a class="text-sm font-semibold text-amber underline underline-offset-4 hover:text-ink" href="/apps">App directory &rarr;</a>
  </div>
  <div class="grid gap-5 md:grid-cols-3">{featuredApps.map((app) => <AppCard app={app} />)}</div>
</section>