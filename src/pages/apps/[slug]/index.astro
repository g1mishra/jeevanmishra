---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { apps, appBase, appOrigin, SITE_URL } from "../../../data/portfolio";

// Only apps whose pages live on this site. Each one is served at its own
// subdomain; apps with their own domain are linked out to from /apps instead.
export function getStaticPaths() {
  return apps
    .filter((app) => app.hosted)
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;

// Google reads this for the FAQ rich result; it has to mirror what is on the
// page, so both render from the same data.
const faqSchema = app.faq && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: app.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const linkLabels: Record<string, string> = {
  playStore: "Get it on Google Play →",
  appStore: "Download on the App Store →",
  live: "Open the app →",
};
---

<Layout
  title={app.seo?.title ?? `${app.name} — ${app.tagline}`}
  description={app.seo?.description ?? app.description}
  canonical={`${appOrigin(app)}/`}
  schemas={faqSchema ? [faqSchema] : []}
>
  <Nav base={SITE_URL} />

  <main class="mx-auto w-full max-w-3xl px-5 py-12 sm:px-8 sm:py-20" transition:animate="slide">
    <a
      class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-amber transition-colors hover:text-amber-light"
      href={`${SITE_URL}/apps`}>← All apps</a
    >

    {
      app.status === "coming-soon" && (
        <p class="mt-10 inline-flex items-center gap-2 rounded-full border border-amber/30 bg-amber-light px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-amber">
          Coming soon
        </p>
      )
    }

    <h1 class="mt-6 font-display text-6xl font-semibold leading-none text-ink sm:text-7xl reveal">
      {app.name}
    </h1>
    <p class="mt-6 text-xl leading-8 text-muted reveal" style="animation-delay: 0.1s">
      {app.tagline}
    </p>

    <div class="mt-8 flex flex-wrap gap-3 reveal" style="animation-delay: 0.15s">
      {
        app.tags.map((tag) => (
          <span class="rounded-full border border-border bg-card px-3 py-1.5 font-mono text-xs font-semibold uppercase tracking-widest text-muted">
            {tag}
          </span>
        ))
      }
    </div>

    <p class="mt-12 text-lg leading-8 text-muted reveal" style="animation-delay: 0.2s">
      {app.lead ?? app.description}
    </p>

    {
      app.sections?.map((section, i) => (
        <section class="mt-16 reveal" style={`animation-delay: ${0.25 + i * 0.05}s`}>
          <h2 class="font-display text-3xl font-semibold text-ink">{section.heading}</h2>

          {section.lead && (
            <p class="mt-6 text-lg leading-8 text-muted">{section.lead}</p>
          )}

          {section.table && (
            <div class="mt-6 overflow-x-auto">
              <table class="w-full border-collapse text-left text-lg">
                <thead>
                  <tr>
                    {section.table.columns.map((column) => (
                      <th class="border-b border-border py-3 pr-6 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-muted">
                        {column}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map(([left, right]) => (
                    <tr>
                      <td class="border-b border-border py-3 pr-6 font-semibold text-ink whitespace-nowrap">
                        {left}
                      </td>
                      <td class="border-b border-border py-3 leading-8 text-muted">{right}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.bullets && (
            <ul class="mt-6 space-y-4 text-lg leading-8 text-muted">
              {section.bullets.map((bullet) => (
                <li class="flex gap-4">
                  <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-amber" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}

          {section.note && (
            <p class="mt-6 border-l-2 border-amber/40 pl-5 text-lg leading-8 text-muted">
              {section.note}
            </p>
          )}
        </section>
      ))
    }

    {
      app.faq && (
        <section class="mt-16 reveal" style="animation-delay: 0.4s">
          <h2 class="font-display text-3xl font-semibold text-ink">Questions</h2>
          <dl class="mt-6 space-y-6 text-lg leading-8">
            {app.faq.map((item) => (
              <div>
                <dt class="font-semibold text-ink">{item.question}</dt>
                <dd class="mt-2 text-muted">{item.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      Object.keys(app.links).length > 0 && (
        <div class="mt-14 flex flex-wrap gap-5 text-sm font-semibold reveal">
          {Object.entries(app.links).map(([key, href]) => (
            <a
              class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-2.5 !text-paper transition hover:scale-105 hover:bg-ink/80"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {linkLabels[key] ?? key}
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-20 border-t border-border pt-8 text-sm text-muted">
      <p>
        {app.packageName && (
          <span class="font-mono text-xs">{app.packageName}</span>
        )}
      </p>
      <p class="mt-3">
        <a class="text-amber transition-colors hover:text-ink" href={`${appBase(app)}/privacy`}>
          Privacy policy
        </a>
        <span class="mx-2 text-border">·</span>
        <a class="transition-colors hover:text-ink" href="mailto:g1mishra.dev@gmail.com">
          Support
        </a>
      </p>
    </div>
  </main>

  <Footer base={SITE_URL} />
</Layout>
