---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { apps } from "../../../data/portfolio";

// Only apps whose pages live on this site. Apps with their own domain
// (JaapMitra, Saarthi) are linked out to from /apps instead.
export function getStaticPaths() {
  return apps
    .filter((app) => app.privacy)
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;

const linkLabels: Record<string, string> = {
  playStore: "Get it on Google Play →",
  appStore: "Download on the App Store →",
  live: "Open the app →",
};
---

<Layout
  title={`${app.name} — ${app.tagline}`}
  description={app.description}
>
  <Nav />

  <main class="mx-auto w-full max-w-3xl px-5 py-12 sm:px-8 sm:py-20" transition:animate="slide">
    <a
      class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-amber transition-colors hover:text-amber-light"
      href="/apps">← All apps</a
    >

    {
      app.status === "coming-soon" && (
        <p class="mt-10 inline-flex items-center gap-2 rounded-full border border-amber/30 bg-amber-light px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-amber">
          Coming soon
        </p>
      )
    }

    <h1 class="mt-6 font-display text-6xl font-semibold leading-none text-ink sm:text-7xl reveal">
      {app.name}
    </h1>
    <p class="mt-6 text-xl leading-8 text-muted reveal" style="animation-delay: 0.1s">
      {app.tagline}
    </p>

    <div class="mt-8 flex flex-wrap gap-3 reveal" style="animation-delay: 0.15s">
      {
        app.tags.map((tag) => (
          <span class="rounded-full border border-border bg-card px-3 py-1.5 font-mono text-xs font-semibold uppercase tracking-widest text-muted">
            {tag}
          </span>
        ))
      }
    </div>

    <p class="mt-12 text-lg leading-8 text-muted reveal" style="animation-delay: 0.2s">
      {app.description}
    </p>

    {
      app.features && (
        <section class="mt-16 reveal" style="animation-delay: 0.25s">
          <h2 class="font-display text-3xl font-semibold text-ink">What's inside</h2>
          <ul class="mt-6 space-y-4 text-lg leading-8 text-muted">
            {app.features.map((feature) => (
              <li class="flex gap-4">
                <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-amber" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      Object.keys(app.links).length > 0 && (
        <div class="mt-14 flex flex-wrap gap-5 text-sm font-semibold reveal">
          {Object.entries(app.links).map(([key, href]) => (
            <a
              class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-2.5 !text-paper transition hover:scale-105 hover:bg-ink/80"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {linkLabels[key] ?? key}
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-20 border-t border-border pt-8 text-sm text-muted">
      <p>
        {app.packageName && (
          <span class="font-mono text-xs">{app.packageName}</span>
        )}
      </p>
      <p class="mt-3">
        <a class="text-amber transition-colors hover:text-ink" href={`/apps/${app.slug}/privacy`}>
          Privacy policy
        </a>
        <span class="mx-2 text-border">·</span>
        <a class="transition-colors hover:text-ink" href="mailto:g1mishra.dev@gmail.com">
          Support
        </a>
      </p>
    </div>
  </main>

  <Footer />
</Layout>
