---
import { Image } from "astro:assets";
import AppLayout from "../../../layouts/AppLayout.astro";
import AppStoreLinks from "../../../components/AppStoreLinks.astro";
import { appAsset } from "../../../data/appAssets";
import { apps, appOrigin } from "../../../data/portfolio";

// Only apps whose pages live on this site. Each one is served at its own
// subdomain; apps with their own domain are linked out to from /apps instead.
export function getStaticPaths() {
  return apps
    .filter((app) => app.hosted)
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;

const heroImage = appAsset(app.heroImage?.file);
const gallery = (app.screenshots ?? []).flatMap((shot) => {
  const image = appAsset(shot.file);
  return image ? [{ ...shot, image }] : [];
});

---

<AppLayout
  app={app}
  title={app.seo?.title ?? `${app.name} - ${app.tagline}`}
  description={app.seo?.description ?? app.description}
  ogImage={app.ogImage}
  canonical={`${appOrigin(app)}/`}
>
  <main class="mx-auto w-full max-w-5xl px-5 pt-10 pb-4 sm:px-8 sm:pt-16">
    <section class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        {
          app.status === "coming-soon" && (
            <p class="mb-8 inline-flex items-center gap-2 rounded-full border border-amber/30 bg-amber-light px-4 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-amber">
              Coming soon
            </p>
          )
        }

        <h1 class="font-display text-6xl font-bold leading-none text-amber sm:text-7xl">
          {app.name}
        </h1>
        <p class="mt-6 text-xl leading-8 text-ink/80">
          {app.tagline}
        </p>

        <AppStoreLinks links={app.links} class="mt-9" />

        {
          app.highlights && (
            <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-bold uppercase tracking-[0.12em] text-muted">
              {app.highlights.map((highlight) => (
                <li class="flex items-center gap-2">
                  <span class="h-1 w-1 shrink-0 rounded-full bg-amber" />
                  {highlight}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        heroImage && (
          <div class="overflow-hidden rounded-3xl border border-border shadow-2xl">
            <Image
              src={heroImage}
              alt={app.heroImage!.alt}
              width={1100}
              class="block w-full"
              loading="eager"
            />
          </div>
        )
      }
    </section>

    <p class="mt-20 text-lg leading-8 text-muted reveal">
      {app.lead ?? app.description}
    </p>

    {
      gallery.length > 0 && (
        <section class="mt-16 reveal">
          <div class="-mx-5 flex gap-4 overflow-x-auto px-5 pb-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4">
            {gallery.map((shot) => (
              <figure class="w-[224px] shrink-0 sm:w-full">
                <div class="overflow-hidden rounded-2xl border border-border">
                  <Image
                    src={shot.image}
                    alt={shot.alt}
                    width={560}
                    class="block w-full"
                    loading="lazy"
                  />
                </div>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      app.sections?.map((section) => (
        <section class="mt-24 reveal">
          <h2 class="font-display text-4xl font-bold text-ink sm:text-5xl">{section.heading}</h2>

          {section.lead && <p class="mt-6 text-lg leading-8 text-muted">{section.lead}</p>}

          {(section.table || section.note) && (
            <div class="mt-8 space-y-6">
              {section.table && (
                <div class="overflow-x-auto rounded-2xl border border-border bg-card p-2 sm:p-4">
                  <table class="w-full border-collapse text-left text-lg">
                    <thead>
                      <tr>
                        {section.table.columns.map((column) => (
                          <th class="border-b border-border px-4 py-3 text-xs font-bold uppercase tracking-[0.12em] text-muted">
                            {column}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map(([left, right]) => (
                        <tr>
                          <td class="border-b border-border px-4 py-3 font-bold whitespace-nowrap text-amber">
                            {left}
                          </td>
                          <td class="border-b border-border px-4 py-3 leading-8 text-muted">
                            {right}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {section.note && (
                <p class="rounded-2xl border border-amber/25 bg-amber-light px-6 py-5 text-lg leading-8 text-muted">
                  {section.note}
                </p>
              )}
            </div>
          )}

          {section.bullets && (
            <ul class="mt-8 space-y-4 text-lg leading-8 text-muted">
              {section.bullets.map((bullet) => (
                <li class="flex gap-4">
                  <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-amber" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {
      app.faq && (
        <section class="mt-24 reveal">
          <h2 class="font-display text-4xl font-bold text-ink sm:text-5xl">Pachisi game questions</h2>
          <dl class="mt-8 space-y-4">
            {app.faq.map((item) => (
              <div class="rounded-2xl border border-border bg-card p-6">
                <dt class="font-display text-xl font-semibold text-ink">{item.question}</dt>
                <dd class="mt-2 text-lg leading-8 text-muted">{item.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      Object.keys(app.links).length > 0 && (
        <section class="mt-24 rounded-3xl border border-amber/25 bg-amber-light px-8 py-14 text-center reveal sm:px-14">
          <h2 class="font-display text-4xl font-bold text-amber sm:text-5xl">Get {app.name}</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-ink/80">{app.tagline}</p>
          <AppStoreLinks links={app.links} class="mt-9 justify-center" />
        </section>
      )
    }
  </main>
</AppLayout>
