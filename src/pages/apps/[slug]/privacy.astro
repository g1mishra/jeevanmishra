---
import AppLayout from "../../../layouts/AppLayout.astro";
import { apps, meta, appBase, appOrigin } from "../../../data/portfolio";
import type { AppService } from "../../../data/portfolio";

export function getStaticPaths() {
  return apps
    .filter((app) => app.hosted && app.privacy)
    .map((app) => ({
      params: { slug: app.slug },
      props: { app, privacy: app.privacy! },
    }));
}

const { app, privacy } = Astro.props;

const effectiveDate = new Date(privacy.effective).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

/** Every SDK that sends data off the device, in the order the policy discusses them. */
const services: AppService[] = [privacy.advertising, privacy.diagnostics, privacy.analytics].filter(
  (service): service is AppService => service !== null,
);

const count = ["no", "one", "two", "three", "four"][services.length] ?? String(services.length);

/** "Google AdMob — showing ads; Google Firebase Crashlytics — reporting crashes; …" */
const servicesInline = services
  .map((service) => `${service.name} — ${service.purpose.replace(/^./, (c) => c.toLowerCase())}`)
  .join("; ");

/** Services with a stated retention period, other than advertising (covered separately). */
const retained = services.filter(
  (service) => service.retention && service !== privacy.advertising,
);

let section = 0;
const n = () => String(++section).padStart(2, "0");
---

<AppLayout
  app={app}
  title={`Privacy Policy — ${app.name}`}
  description={`Privacy policy for the ${app.name} mobile app by ${meta.name}. ${privacy.summary}`}
  ogImage={app.ogImage}
  canonical={`${appOrigin(app)}/privacy`}
>
  <main class="mx-auto w-full max-w-5xl px-5 pt-10 pb-4 sm:px-8 sm:pt-16">
    <a
      class="text-xs font-bold uppercase tracking-[0.12em] text-amber transition-colors hover:text-ink"
      href={`${appBase(app)}/`}>← {app.name}</a
    >

    <h1 class="mt-10 font-display text-5xl font-bold leading-tight text-ink sm:text-6xl">
      Privacy Policy
    </h1>
    <p class="mt-4 text-xl text-muted">
      for <strong class="font-medium text-ink">{app.name}</strong>
      {app.packageName && <span class="font-mono text-sm">({app.packageName})</span>}
    </p>
    <p class="mt-2 text-xs font-bold uppercase tracking-[0.12em] text-muted">
      Effective {effectiveDate}
    </p>

    <div class="mt-10 rounded-2xl border border-amber/25 bg-amber-light p-6 text-lg leading-8 text-ink">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-amber">
        In short
      </p>
      <p class="mt-3">{privacy.summary}</p>
    </div>

    <div class="mt-16 space-y-14 text-lg leading-8 text-muted">
      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Who this policy is from
        </h2>
        <p class="mt-4">
          {app.name} is built and published by {meta.name}, an independent developer based in
          India. This policy explains what the app does and does not do with information when
          you use it. In it, "I" and "my" refer to the developer, and "the app" refers to
          {" "}{app.name}.
        </p>
      </section>

      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Information I collect
        </h2>
        <p class="mt-4">
          {
            privacy.collectsPersonalData
              ? "The app collects the personal information described below."
              : "I do not myself collect, store, or transmit any personal information about you. The app has no servers of mine that it talks to, and nothing you do inside it reaches me in a form that could identify you."
          }
        </p>
        {
          !privacy.requiresAccount && (
            <p class="mt-4">
              There is no account and no sign-in. You are never asked for a name, an email
              address, a phone number, or any other identifying detail.
            </p>
          )
        }
        {
          services.length > 0 && (
            <>
              <p class="mt-4">
                The app does include {count} Google {services.length === 1 ? "SDK" : "SDKs"} that{" "}
                {services.length === 1 ? "sends" : "send"} some information to Google:{" "}
                {servicesInline}. Each is described in its own section below. Here is what they
                receive, in one place:
              </p>
              <div class="mt-8 overflow-x-auto rounded-2xl border border-border bg-card p-2 sm:p-4">
                <table class="w-full border-collapse text-left text-lg">
                  <thead>
                    <tr>
                      <th class="border-b border-border px-4 py-3 text-xs font-bold uppercase tracking-[0.12em] text-muted">
                        Service
                      </th>
                      <th class="border-b border-border px-4 py-3 text-xs font-bold uppercase tracking-[0.12em] text-muted">
                        What leaves your device
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {services.map((service) => (
                      <tr>
                        <td class="border-b border-border px-4 py-3 align-top font-bold text-amber sm:whitespace-nowrap">
                          {service.name}
                          <span class="mt-1 block text-sm font-normal text-muted">{service.purpose}</span>
                        </td>
                        <td class="border-b border-border px-4 py-3 align-top leading-8 text-muted">
                          <ul class="ml-4 space-y-1">
                            {service.collects.map((item) => (
                              <li class="list-disc">{item}</li>
                            ))}
                          </ul>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="mt-6">
                Nothing else leaves the device: no name, no email address, no contacts, no
                precise location, no files. None of these services receives anything from me
                that could identify you, and all of them encrypt what they send in transit.
              </p>
            </>
          )
        }
        {
          privacy.worksOffline && (
            <p class="mt-4">
              The game itself runs entirely on your device and works with no connection at all.
            </p>
          )
        }
      </section>

      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Data stored on your device
        </h2>
        <p class="mt-4">
          The app saves the following to your device's own storage so it can work between
          sessions:
        </p>
        <ul class="mt-6 space-y-3 pl-5">
          {privacy.onDeviceData.map((item) => (
            <li class="list-disc">{item}</li>
          ))}
        </ul>
        <p class="mt-4">
          This data never leaves your device and is not readable by me or by anyone else. It is
          removed when you clear the app's data or uninstall the app.
        </p>
      </section>

      {
        privacy.advertising && (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
              <span class="text-amber">{n()}.</span> Advertising
            </h2>
            <p class="mt-4">{privacy.advertising.note}</p>
            {privacy.advertising.retention && <p class="mt-4">{privacy.advertising.retention}</p>}
            <p class="mt-4">
              How {privacy.advertising.name} handles this information is governed by Google's
              own policy, which you can read here:{" "}
              <a
                class="text-amber underline underline-offset-4 transition-colors hover:text-ink"
                href={privacy.advertising.policyUrl}
                target="_blank"
                rel="noopener noreferrer"
                >{privacy.advertising.policyUrl}</a
              >.
            </p>
          </section>
        )
      }

      {
        privacy.diagnostics && (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
              <span class="text-amber">{n()}.</span> Crash reporting
            </h2>
            <p class="mt-4">{privacy.diagnostics.note}</p>
            {privacy.diagnostics.retention && <p class="mt-4">{privacy.diagnostics.retention}</p>}
            <p class="mt-4">
              How {privacy.diagnostics.name} handles this information is governed by Google's
              own policy, which you can read here:{" "}
              <a
                class="text-amber underline underline-offset-4 transition-colors hover:text-ink"
                href={privacy.diagnostics.policyUrl}
                target="_blank"
                rel="noopener noreferrer"
                >{privacy.diagnostics.policyUrl}</a
              >.
            </p>
          </section>
        )
      }

      {
        privacy.analytics && (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
              <span class="text-amber">{n()}.</span> Analytics
            </h2>
            <p class="mt-4">{privacy.analytics.note}</p>
            {privacy.analytics.retention && <p class="mt-4">{privacy.analytics.retention}</p>}
            <p class="mt-4">
              How {privacy.analytics.name} handles this information is governed by Google's
              own policy, which you can read here:{" "}
              <a
                class="text-amber underline underline-offset-4 transition-colors hover:text-ink"
                href={privacy.analytics.policyUrl}
                target="_blank"
                rel="noopener noreferrer"
                >{privacy.analytics.policyUrl}</a
              >.
            </p>
          </section>
        )
      }

      {
        (privacy.advertising || privacy.analytics) && (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
              <span class="text-amber">{n()}.</span> Your choices
            </h2>
            {privacy.advertising && (
              <p class="mt-4">
                <strong class="font-medium text-ink">Your Advertising ID</strong> is controlled by
                Android, not by the app. Open{" "}
                <strong class="font-medium text-ink">Settings → Privacy → Ads</strong> (on some
                phones, Settings → Google → Ads). There you can{" "}
                <strong class="font-medium text-ink">reset</strong> the ID, which breaks the link
                to anything collected under the old one, or{" "}
                <strong class="font-medium text-ink">delete</strong> it, after which apps receive a
                string of zeros in its place and ads can no longer be personalised to you. The app
                keeps working normally either way; you simply see less relevant ads.
              </p>
            )}
            {privacy.advertising && (
              <p class="mt-4">
                <strong class="font-medium text-ink">Ad personalisation and consent.</strong> In
                regions where the law requires it, such as the European Economic Area and the
                United Kingdom, the app shows Google's consent form the first time it runs, and
                ads are personalised only if you agreed. You can review or change that answer at
                any time from inside the app, at{" "}
                <strong class="font-medium text-ink">Settings → Ad privacy options</strong>.
                {privacy.analytics &&
                  " The same answer governs analytics: where a consent form applies, nothing is measured until you have answered it, and your choice is respected afterwards."}{" "}
                Outside those regions there is no consent form to reopen, so that row does not
                appear in Settings; the Android controls above still apply.
              </p>
            )}
          </section>
        )
      }

      {
        privacy.permissions.length > 0 && (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
              <span class="text-amber">{n()}.</span> Permissions the app requests
            </h2>
            <ul class="mt-6 space-y-5">
              {privacy.permissions.map((permission) => (
                <li>
                  <strong class="font-medium text-ink">{permission.name}</strong>
                  <span class="block">{permission.reason}</span>
                </li>
              ))}
            </ul>
            <p class="mt-6">
              The app does not ask for location, camera, microphone, contacts, or storage
              permissions.
            </p>
          </section>
        )
      }

      {
        privacy.thirdParties.length > 0 && (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
              <span class="text-amber">{n()}.</span> Other third-party services
            </h2>
            <p class="mt-4">
              The app also includes the following services. Each one handles data under its own
              privacy policy, not mine:
            </p>
            <ul class="mt-6 space-y-5">
              {privacy.thirdParties.map((party) => (
                <li>
                  <strong class="font-medium text-ink">{party.name}</strong> — {party.purpose}.
                  <a
                    class="ml-1 text-amber underline underline-offset-4 transition-colors hover:text-ink"
                    href={party.policyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Privacy policy
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Children's privacy
        </h2>
        <p class="mt-4">
          {
            privacy.childDirected
              ? "The app is directed at children and is designed to comply with the Google Play Families policy and applicable children's privacy laws."
              : `${app.name} is intended for people aged 13 and over. It is not directed at children under 13, is not part of Google Play's Families programme, and I do not knowingly collect information from anyone under 13. Because there is no account, the app holds nothing that could name a child. If you believe a child under 13 has used the app and that information about them has reached one of the services above, contact me and I will help you address it, including through Google's own controls.`
          }
        </p>
      </section>

      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Keeping and deleting your data
        </h2>
        <p class="mt-4">
          There is no account, so there is nothing to delete on my side: I hold no data about
          you to request, export, or erase, and the app has no delete-my-account function
          because there is no account to delete. Everything the app saves lives on your device
          and is entirely under your control: clear the app's storage from your device settings,
          or uninstall the app, and it is gone for good.
        </p>
        {
          services.length > 0 && (
            <>
              <p class="mt-4">
                What Google receives through the services above is held by Google under its own
                retention rules, not by me:
              </p>
              <ul class="mt-6 space-y-3 pl-5">
                {privacy.advertising && (
                  <li class="list-disc">
                    <strong class="font-medium text-ink">{privacy.advertising.name}</strong> —
                    governed by Google's advertising retention policies and by your Advertising
                    ID. Resetting or deleting the ID, as described above, is how you break the
                    link to anything collected under it.
                  </li>
                )}
                {retained.map((service) => (
                  <li class="list-disc">
                    <strong class="font-medium text-ink">{service.name}</strong> —{" "}
                    {service.retention}
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </section>

      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Changes to this policy
        </h2>
        <p class="mt-4">
          If the app changes in a way that affects this policy, I will update this page and move
          the effective date at the top. Material changes will also be noted in the app's release
          notes on the Play Store.
        </p>
      </section>

      <section>
        <h2 class="flex items-center gap-4 font-display text-2xl font-semibold text-ink">
          <span class="text-amber">{n()}.</span> Contact
        </h2>
        <p class="mt-4">
          Questions about this policy, or about the app in general, reach me directly at{" "}
          <a
            class="text-amber underline underline-offset-4 transition-colors hover:text-ink"
            href={`mailto:${privacy.contactEmail}`}>{privacy.contactEmail}</a
          >. It is the same address the app's own feedback button writes to. I read everything.
        </p>
      </section>
    </div>
  </main>
</AppLayout>
