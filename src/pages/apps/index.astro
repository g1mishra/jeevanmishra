---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageIntro from "../../components/PageIntro.astro";
import AppCard from "../../components/AppCard.astro";
import { apps } from "../../data/portfolio";
---
<Layout title="Apps - Jeevan Kumar" description="Android apps built and published by Jeevan Kumar. Explore their websites and Google Play listings.">
  <Nav />
  <main class="mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8" transition:animate="slide">
    <PageIntro title="Small apps. Built with care." description="A daily practice companion, a little Gita guidance, and a traditional board game. Three apps I've built and published, each with a purpose of its own." />
    <section aria-label="Published apps" class="grid gap-6 py-12 sm:py-16">
      {apps.map((app) => <AppCard app={app} heading="h2" detailed />)}
    </section>
    <section aria-labelledby="project-enquiry" class="rounded-2xl border border-border bg-card p-6 sm:p-10">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <h2 id="project-enquiry" class="font-display text-3xl font-semibold text-ink sm:text-4xl">Have an app idea of your own?</h2>
          <p class="mt-4 text-lg leading-7 text-muted">I can help you turn it into a working product, from the first screens and backend to launch. Tell me what you want to build.</p>
        </div>
        <a class="inline-flex shrink-0 self-start items-center rounded-full bg-ink px-6 py-3 text-sm font-semibold !text-paper transition hover:bg-ink/80 focus-visible:outline-2 focus-visible:outline-amber md:self-center" href="mailto:g1mishra.dev@gmail.com?subject=Let%27s%20build%20an%20app">Let's talk &rarr;</a>
      </div>
    </section>
    <p class="mt-6 text-sm leading-6 text-muted">Looking for an app's privacy policy? You'll find it on the app's website linked above.</p>
  </main>
  <Footer />
</Layout>