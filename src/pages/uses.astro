---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageIntro from "../components/PageIntro.astro";
const groups = [
  { title: "Development stack", items: [
    ["Web", "TypeScript, React, Next.js, Astro"], ["Mobile", "React Native, Expo"],
    ["Styling", "Tailwind CSS"], ["Backend & data", "Node.js, Python, Django, MongoDB, SQLite"],
  ] },
  { title: "Editors & tools", items: [
    ["Editors & AI", "Codex, Claude Code, VS Code, Cursor"], ["Source control", "GitHub"],
    ["Hosting", "Vercel for personal web projects"], ["Design", "Figma"],
  ] },
  { title: "Everyday gear", items: [["Phone", "iPhone 15 Pro Max"]],
    note: "A simple setup for writing code, recording ideas, and testing what I build." },
];
---
<Layout title="Uses - Jeevan Kumar" description="The development stack, editors, tools and gear Jeevan Kumar uses to build web and mobile products.">
  <Nav />
  <main class="mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8" transition:animate="slide">
    <PageIntro title="What I build with." description="The languages, tools, and everyday gear behind my web and mobile products." />
    <div class="grid gap-5 py-12 sm:py-16 md:grid-cols-2 lg:grid-cols-3">
      {groups.map((group) => (
        <section class="rounded-2xl border border-border bg-card p-5 sm:p-6">
          <h2 class="font-display text-2xl font-semibold text-ink">{group.title}</h2>
          <dl class="mt-6 divide-y divide-border">
            {group.items.map(([label, value]) => (
              <div class="py-4 first:pt-0">
                <dt class="font-mono text-xs text-muted">{label}</dt>
                <dd class="mt-1 text-base leading-6 text-ink">{value}</dd>
              </div>
            ))}
          </dl>
          {group.note && <p class="mt-4 border-t border-border pt-4 text-sm leading-6 text-muted">{group.note}</p>}
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>