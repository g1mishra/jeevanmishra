{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/apps/jaapmitra/?",
      "has": [{ "type": "host", "value": "jeevanmishra[.]in" }],
      "status": 308,
      "headers": { "Location": "https://jaapmitra.jeevanmishra.in/" }
    },
    {
      "src": "/apps/saarthi/?",
      "has": [{ "type": "host", "value": "jeevanmishra[.]in" }],
      "status": 308,
      "headers": { "Location": "https://trysaarthi.in/" }
    },
    {
      "src": "/apps/(?<slug>[^/]+)/?",
      "has": [{ "type": "host", "value": "jeevanmishra[.]in" }],
      "status": 308,
      "headers": { "Location": "https://$slug.jeevanmishra.in/" }
    },
    {
      "src": "/apps/(?<slug>[^/]+)/(?<rest>.+)",
      "has": [{ "type": "host", "value": "jeevanmishra[.]in" }],
      "status": 308,
      "headers": { "Location": "https://$slug.jeevanmishra.in/$rest" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "(?<slug>(?!www)[a-z0-9-]+)[.]jeevanmishra[.]in" }],
      "dest": "/apps/$slug"
    },
    {
      "src": "/(?<path>(?!_astro/)[^.]+)",
      "has": [{ "type": "host", "value": "(?<slug>(?!www)[a-z0-9-]+)[.]jeevanmishra[.]in" }],
      "dest": "/apps/$slug/$path"
    },
    { "handle": "filesystem" }
  ]
}
